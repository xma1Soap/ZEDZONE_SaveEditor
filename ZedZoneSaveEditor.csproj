<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 是 Win10/Win11 自带的，生成的 exe 双击就能用，不用另装运行库 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ZedZoneSaveEditor</AssemblyName>
    <RootNamespace>ZedZoneSaveEditor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <Product>隔离区人物存档修改器</Product>
    <Description>ZED ZONE 隔离区 单机存档 / 联机角色 人物修改器</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 物品表（tools/export_items.py 从游戏资源导出），打进 exe 里 -->
    <EmbeddedResource Include="src\items.tsv" LogicalName="items.tsv" />
    <!-- 物品图标（tools/export_icons.py 导出）：一张拼图 + 每个图标的位置 -->
    <EmbeddedResource Include="src\icons.png" LogicalName="icons.png" />
    <EmbeddedResource Include="src\icons.tsv" LogicalName="icons.tsv" />
  </ItemGroup>

</Project>
